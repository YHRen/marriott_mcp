{
  "mcpServers": {
    "marriott": {
      "command": "npx",
      "args": [
        "--yes",
        "--package=github:YHRen/marriott_mcp#v0.1.0",
        "--",
        "mcp-marriott"
      ],
      "env": {
        "MARRIOTT_CDP_URL": "http://127.0.0.1:9222",
        "MARRIOTT_SPECIAL_RATES": "government",
        "MARRIOTT_GOVERNMENT_SCOPE": "federal"
      }
    }
  }
}
